it continuously compares each Application's desired state (Git) against the live cluster state and triggers sync when they drift. It's what actually applies manifests, detects OutOfSync/drift, and enforces selfHeal/prune policies for every Application, whether created manually or via ApplicationSet.

apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: sample-app
  namespace: argocd
spec:
  project: default
  source:
    repoURL: https://github.com/kamalesh74/my-argocd-apps.git
    targetRevision: main
    path: sample-app
  destination:
    server: https://kubernetes.default.svc
    namespace: default
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
--------------------------
kubectl apply -f sample-app-application.yaml
kubectl get applications -n argocd

